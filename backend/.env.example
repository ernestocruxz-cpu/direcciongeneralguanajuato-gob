NODE_ENV=development
PORT=4000

# Cambia estos datos por los de tu PostgreSQL local o hosting.
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/pago_infracciones

# Cambia este secreto en produccion.
JWT_SECRET=cambia_este_secreto_largo_y_privado
JWT_EXPIRES_IN=8h

# URL publica del frontend. En local puede ser http://localhost:4000 si servimos todo con Express.
PUBLIC_APP_URL=http://localhost:4000

# CORS permitido para desarrollo si abres frontend aparte.
CORS_ORIGIN=http://localhost:8087
